# Dependencies and build output
node_modules/
.pnpm-store/
dist/
build/
coverage/
.vite/
.parcel-cache/
.cache/

# Python caches and local tooling output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Editors and OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs, temporary files, and local scratch artifacts
*.log
*.tmp
*.bak
*.orig
*.rej
*.cache
$out

# Future real terrain inputs require separate source and licence metadata.
# They are not yet present in this repository.
assets/map/source/*.tif
assets/map/source/*.tiff
assets/map/source/*.dem
assets/terrain/derived/

# Local review exports and generated source tiles are retained locally but are
# not part of the static site release.
.cleanup-archive-*.zip
analysis/*.png
analysis/*.jpg
analysis/*.svg
assets/terrain/source/
docs/screenshots/*.png
docs/screenshots/*.jpg
docs/screenshots/*.jpeg
